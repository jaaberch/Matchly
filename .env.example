# ─────────────────────────────────────────────────────────────────────────────
# Matchly configuration
#
# Copy to `.env` and adjust. Never commit `.env`, and never put a real secret in
# this file — it is committed. Production values come from the deployment's
# secret manager, not from a file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development           # development | test | staging | production
DEBUG=false
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                # console for a terminal, json in containers

# ── URLs ─────────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://matchly:matchly@localhost:5432/matchly
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Used by `make test-pg` only; the default test run uses SQLite and needs no server.
# TEST_DATABASE_URL=postgresql+psycopg://matchly:matchly@localhost:5432/matchly_test

# ── Broker / background jobs ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=                # defaults to REDIS_URL
# CELERY_RESULT_BACKEND=            # defaults to REDIS_URL
CELERY_TASK_ALWAYS_EAGER=false      # true runs tasks inline; tests only

# ── Object storage ───────────────────────────────────────────────────────────
# `local` writes to disk and needs nothing else running — good for a first run.
# `s3` speaks to MinIO in development and to Cloudflare R2 or AWS S3 in production;
# the application code is identical either way.
STORAGE_BACKEND=s3                  # local | s3
STORAGE_LOCAL_PATH=./.storage
STORAGE_BUCKET_ORIGINALS=matchly-originals
STORAGE_BUCKET_DERIVED=matchly-derived
SIGNED_URL_TTL_SECONDS=3600

# MinIO (development). For Cloudflare R2 use:
#   S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
# For AWS S3, leave S3_ENDPOINT_URL unset and set a real region.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=matchly
S3_SECRET_ACCESS_KEY=matchly-dev-secret
S3_FORCE_PATH_STYLE=true

MINIO_ROOT_USER=matchly
MINIO_ROOT_PASSWORD=matchly-dev-secret

# ── Authentication ───────────────────────────────────────────────────────────
# Generate a real one with: openssl rand -hex 32
# The API refuses to start outside development while this is the placeholder.
JWT_SECRET_KEY=dev-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900        # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000   # 30 days

# `mock` returns the code in the API response so development needs no SMS vendor.
# Implementing a real provider means writing one `send` method — see
# packages/shared/matchly_shared/otp/base.py.
OTP_PROVIDER=mock                   # mock | log
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_REQUEST_WINDOW_SECONDS=600
OTP_EXPOSE_DEV_CODE=true            # ignored outside development

# ── Computer vision ──────────────────────────────────────────────────────────
# Build the worker image with the CV stack (torch, ultralytics, opencv). Set to
# false for a media-only deployment: matches still complete, scored on motion.
INSTALL_CV=true
YOLO_WEIGHTS=yolov8n.pt
YOLO_CONFIDENCE=0.25
YOLO_IMAGE_SIZE=640
YOLO_BATCH_SIZE=16
# Cap on frames fed to detection. An hour at 2 fps is 7,200 frames; this is what
# stops a backlog taking a day to clear.
MAX_DETECTION_FRAMES=4000

JERSEY_CROPS_PER_TRACK=8
JERSEY_MIN_VOTES=3
JERSEY_MIN_SHARE=0.5
JERSEY_MIN_MARGIN=0.15

# Signal weights for the heuristic scorer. Renormalised over whichever signals a
# recording actually produced, so a camera with no microphone is not penalised.
SIGNAL_WEIGHT_MOTION=0.30
SIGNAL_WEIGHT_PLAYER_DENSITY=0.25
SIGNAL_WEIGHT_ACCELERATION=0.20
SIGNAL_WEIGHT_DIRECTION_CHANGE=0.10
SIGNAL_WEIGHT_AUDIO_PEAK=0.10
SIGNAL_WEIGHT_CLUSTERING=0.05

# ── Domain ───────────────────────────────────────────────────────────────────
CAMERA_OFFLINE_AFTER_SECONDS=120
DEFAULT_VIDEO_RETENTION_DAYS=90
JOIN_CODE_LENGTH=6

# ── Compose port mapping (optional) ──────────────────────────────────────────
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
